# Django
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - either set DATABASE_URL, or the individual DB_* vars below
DATABASE_URL=
DB_NAME=ap_automation
DB_USER=apuser
DB_PASSWORD=apuser_dev_pw
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR
# OCR_PROVIDER: tesseract (local OCR) | demo (deterministic fallback, no OCR) | textract | docai | azure
OCR_PROVIDER=tesseract
OCR_API_KEY=

# Uploads
MAX_UPLOAD_SIZE_MB=15

# Email ingestion (optional) -- lets `python manage.py ingest_invoice_emails`
# pull invoice attachments from an inbox. Leave blank to leave the feature off.
# For Gmail: enable 2-Step Verification, then create an "App Password" at
# myaccount.google.com/apppasswords and use that here, not your normal password.
EMAIL_INGEST_HOST=imap.gmail.com
EMAIL_INGEST_PORT=993
EMAIL_INGEST_USER=
EMAIL_INGEST_PASSWORD=
EMAIL_INGEST_FOLDER=INBOX
EMAIL_INGEST_DEPARTMENT=
